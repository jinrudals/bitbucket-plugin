<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Push events" field="pushEvents">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="Pull request created" field="pullRequestCreated">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="Pull request updated" field="pullRequestUpdated">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="Source branch includes" field="sourceBranchIncludes">
    <f:textbox/>
  </f:entry>
  <f:entry title="Source branch excludes" field="sourceBranchExcludes">
    <f:textbox/>
  </f:entry>
  <f:entry title="Target branch includes" field="targetBranchIncludes">
    <f:textbox/>
  </f:entry>
  <f:entry title="Target branch excludes" field="targetBranchExcludes">
    <f:textbox/>
  </f:entry>
  <f:entry title="Ignore draft pull requests" field="ignoreDraft">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="Allow pull requests from forks" field="allowForkPullRequests">
    <f:checkbox/>
  </f:entry>
  <f:entry title="Skip duplicate commits" field="skipDuplicateCommit">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="Credentials" field="credentialsId">
    <c:select/>
  </f:entry>
</j:jelly>
