<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:l="/lib/layout">
  <f:entry title="Webhook URL"
           description="Use this URL as the webhook URL in Bitbucket Cloud (Repository settings, Webhooks). It is generated from the job path; you do not need to edit it.">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <f:readOnlyTextbox value="${descriptor.webhookUrl(it)}"/>
      <l:copyButton text="${descriptor.webhookUrl(it)}"/>
    </div>
  </f:entry>
  <f:entry title="Secret" field="secretText"
           description="Enter the same value as the webhook secret in Bitbucket Cloud. A random secret is generated by default.">
    <f:textbox default="${descriptor.newSecret()}"/>
  </f:entry>
  <f:entry title="Rules" field="rules">
    <f:repeatableProperty field="rules" add="Add rule" minimum="1"/>
  </f:entry>
</j:jelly>
