<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="Bitbucket Cloud">
    <f:entry title="Workspace connections">
      <f:repeatableProperty field="workspaceConnections"/>
    </f:entry>
    <f:entry title="Webhook secret" field="webhookSecretId">
      <c:select/>
    </f:entry>
    <f:entry title="Default credentials" field="defaultCredentialsId">
      <c:select/>
    </f:entry>
    <f:entry title="Allow unsigned webhooks" field="allowUnsignedWebhooks">
      <f:checkbox/>
    </f:entry>
    <f:entry title="API base URL" field="apiBaseUrl">
      <f:textbox default="https://api.bitbucket.org"/>
    </f:entry>
  </f:section>
</j:jelly>
